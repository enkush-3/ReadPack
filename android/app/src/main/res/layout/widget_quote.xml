<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/widget_badge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📖 ӨДРИЙН ЭШЛЭЛ"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:textColor="#6750A4" />

        <TextView
            android:id="@+id/widget_app_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ReadPack"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#49454F" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_quote_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:text="&quot;Ном уншдаг хүн үхэхээсээ өмнө мянган амьдралаар амьдардаг.&quot;"
        android:textSize="14sp"
        android:textStyle="italic"
        android:fontFamily="serif"
        android:lineSpacingMultiplier="1.2"
        android:textColor="#1D1B20"
        android:maxLines="4"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_author"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="— Жорж Р.Р. Мартин · ReadPack"
        android:textSize="11.5sp"
        android:textStyle="bold"
        android:textColor="#49454F"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="8dp" />

</LinearLayout>
