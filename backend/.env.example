NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/readpack
ALLOW_JSON_FALLBACK=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# Generate independent random values with at least 32 bytes of entropy.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
OTP_HASH_SECRET=
NOTIFICATION_SERVICE_TOKEN=

GOOGLE_CLIENT_IDS=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Firebase Admin service-account JSON, serialized on one line. Keep the real value outside source control.
FIREBASE_SERVICE_ACCOUNT_JSON=
